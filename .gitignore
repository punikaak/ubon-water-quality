# Satellite composites and trained models - too large / not meant for git.
# Deployed app fetches these from Google Drive at runtime instead (see
# province_composite.py / turbidity_model.py). Local dev keeps them on disk.
*.tif
*.pkl
!best_model_neural_network_mlp.pkl
!scaler_ubon_operational.pkl
!calibrator_neural_network_mlp.pkl

# Historical analysis plots from earlier training iterations - not used by
# the dashboard, just exploratory artifacts.
Model_*.png
Plot_*.png
Prediction_*.png
Validation_*.png
Figure_*.png

# Dead/unused cache (superseded by thailand_provinces.geojson etc.)
ubon_water.json

# The boundary source archives, and anything unpacked from them. These ARE
# where every province and district line comes from - but they are converted
# once by import_shapefiles.py into the two committed .geojson caches that the
# app actually reads, so the repo never needs them. Keeping them out matters:
# the amphoe .shp alone is 40MB, over GitHub's recommended file limit and dead
# weight on every Streamlit Cloud deploy.
Province Shapefile/
Tambon Shapefile/
Amphoe Shapefile/
Wetland/
Stream/
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.cst
*.qpj
*.sr.lock

# Raw Overpass response behind thailand_water.geojson (fetch_osm_water.py).
# 155MB, ~30x the GeoJSON built from it, and carries nothing the GeoJSON
# doesn't - it exists so the size thresholds can be retuned without asking a
# donated public service for the hydrography of Thailand again.
.osm_water_raw.json
.osm_water_raw.json.part

# The hydrology archive and anything unpacked from it. Same reasoning as the
# boundary archives above: *.shp and *.zip already catch the layers, this
# catches the ESRI sidecars (.sbn/.sbx/.shp.xml) that come with them.
Hydrology/

# Runtime cache for composites downloaded from Drive by the deployed app.
# Not to be confused with display_rasters/, which IS committed - that one is
# the precomputed map layer the app renders from, and shipping it is the
# whole point (see province_composite.load_display).
.composite_cache/

# Secrets - never commit. Real values live only in Streamlit Cloud's
# secrets manager or your local ~/.config/earthengine/credentials.
.streamlit/secrets.toml
*.json.key
service-account*.json

__pycache__/
*.pyc
.DS_Store

# The boundary archives themselves: "Province Shapefile.zip", "Amphoe
# Shapefile.zip". Blanket rather than by name, so a re-zipped or renamed drop
# cannot be committed by accident.
*.zip
static/turb_*.png
static/value_*.png
