# Copy this into your Streamlit Community Cloud app's Settings > Secrets box
# (as TOML, exactly like this file). Never commit a real secrets.toml - it's
# gitignored for that reason.
#
# Get the real values from H:\ADPC\ADPC\...\.config\earthengine\credentials
# on this machine (open it in a text editor) - it's already JSON, just move
# each field into the matching line below. refresh_token is the sensitive
# one; client_id/client_secret here are Earth Engine's own public installed-
# app identifiers, not secrets tied to your account.

[gcp_drive]
refresh_token = "paste-your-refresh_token-value-here"
client_id = "paste-client_id-value-here"
client_secret = "paste-client_secret-value-here"
scopes = [
    "https://www.googleapis.com/auth/earthengine",
    "https://www.googleapis.com/auth/cloud-platform",
    "https://www.googleapis.com/auth/drive",
    "https://www.googleapis.com/auth/devstorage.full_control",
]
